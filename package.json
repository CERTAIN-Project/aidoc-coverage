{
  "name": "ontology-coverage-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:data": "tsx scripts/pregenerate.ts",
    "build": "npm run build:data && vite build",
